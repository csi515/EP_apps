VITE_SUPABASE_URL=http://127.0.0.1:3001
VITE_SUPABASE_ANON_KEY=ep-anon

# 로컬/사내 커스텀 로그인
VITE_LOCAL_AUTH=true
VITE_AUTH_API_BASE=/api/local-auth
# 사내 PG PostgREST 도메인 SoT (hydrate·Refine·getCoreClient)
VITE_CORP_DOMAIN=true

EP_LOCAL_AUTH_DRIVER=postgres
EP_LOCAL_AUTH_DATABASE_URL=postgresql://ep:ep@127.0.0.1:54329/ep_local
DATABASE_URL=postgresql://ep:ep@127.0.0.1:54329/ep_local
EP_LOCAL_AUTH_SEED_MODE=dev
# Docker Postgres 마이그레이션 엄격 모드 (PGlite 폴백 skip 비활성)
EP_MIGRATE_STRICT=1

AUTH_API_PORT=8787
SESSION_TTL=1209600
EP_JWT_SECRET=ep-local-dev-jwt-secret-change-me
EP_JWT_TTL=1209600
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
EP_LOCAL_AUTH_COOKIE_SECURE=false

# 사내 부트스트랩
# EP_CORP_OWNER_EMAIL=owner@company.example
# EP_CORP_OWNER_PASSWORD=change-me-temp

# 스모크 / PostgREST (Docker stack 기본)
EP_AUTH_API_BASE=http://127.0.0.1:8787/api/local-auth
EP_POSTGREST_URL=http://127.0.0.1:3001
